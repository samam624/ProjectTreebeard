@@ -14,6 +14,10 @@
 #include "bootloader.h"
 #include "bootloader_types.h"
 #include "hci_slip.h"
+
+/* MSV3 1.0.19: dfu_transport_serial.c. Declared here rather than in a header because the serial
+ * transport has no public header of its own in this SDK. */
+void msv3_serial_init_retry_pump(void);
 #include "bootloader_util.h"
 #include "bootloader_settings.h"
 #include "dfu.h"
@@ -169,6 +173,12 @@
       hci_slip_tx_pump();
 
       hci_slip_rx_pump();
+
+      /* MSV3 1.0.19: retry an init packet that arrived before the application-bank erase had
+       * finished. It MUST be pumped from here rather than re-scheduled from inside the scheduler
+       * callback: app_sched_execute() above drains its queue in a loop, so a self-reschedule never
+       * lets this loop turn and pstorage never completes. See MSV3_SERIAL_INIT_RETRY. */
+      msv3_serial_init_retry_pump();
 
       tud_cdc_write_flush();
     }
