diff --git a/lib/sdk/components/libraries/hci/hci_transport.c b/lib/sdk/components/libraries/hci/hci_transport.c
--- a/lib/sdk/components/libraries/hci/hci_transport.c
+++ b/lib/sdk/components/libraries/hci/hci_transport.c
@@ -672,6 +672,60 @@
 }
 
 
+/* MSV3 1.0.16: has the serial side already taken the pool and re-established SLIP on it? */
+static bool m_serial_pool_ready;
+
+/* MSV3 1.0.16: claim the shared RX pool for the SERIAL transport, at its first ingress.
+ *
+ * Called from hci_slip.c's drain loop before a single CDC byte is taken. Returns false when BLE
+ * already owns the pool, which leaves the bytes in the CDC FIFO and NAKs the host at the USB
+ * layer -- the host simply waits, with no host-side change required.
+ *
+ * On the FIRST successful claim the pool has to be re-established for us, because boot left it
+ * initialised for BLE: bootloader.c starts serial and then BLE, and the BLE update_start's
+ * hci_mem_pool_open() reset the indices after hci_transport_open() had already produced a buffer
+ * and registered it with SLIP. So the pool and SLIP disagree until we fix both together here --
+ * reset, produce, register, and clear the decode-ready flag so no stale extract can fire.
+ * See MSV3_POOL_OWNER in hci_mem_pool.c. */
+bool msv3_serial_rx_claim(void)
+{
+    uint32_t err_code;
+
+    if (!hci_mem_pool_try_claim(MSV3_POOL_OWNER_SERIAL))
+    {
+        return false;
+    }
+    if (m_serial_pool_ready)
+    {
+        return true;
+    }
+
+    err_code = hci_mem_pool_open();
+    if (NRF_SUCCESS != err_code)
+    {
+        return false;
+    }
+
+    mp_slip_used_rx_buffer = NULL;
+    err_code = hci_mem_pool_rx_produce(HCI_RX_BUF_SIZE, (void **)&mp_slip_used_rx_buffer);
+    if ((NRF_SUCCESS != err_code) || (NULL == mp_slip_used_rx_buffer))
+    {
+        return false;
+    }
+
+    err_code = hci_slip_rx_buffer_register(mp_slip_used_rx_buffer, HCI_RX_BUF_SIZE);
+    if (NRF_SUCCESS != err_code)
+    {
+        return false;
+    }
+
+    /* Nothing has been decoded into the new buffer yet; a stale true here would extract it. */
+    m_is_slip_decode_ready = false;
+    m_serial_pool_ready    = true;
+    return true;
+}
