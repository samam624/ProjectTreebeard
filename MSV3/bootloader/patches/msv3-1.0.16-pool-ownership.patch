+/**@brief MSV3 1.0.16: exclusive pool ownership. See MSV3_POOL_OWNER in hci_mem_pool.c.
+ *
+ * One hci_mem_pool serves both DFU transports and it is not multiplexed, so exactly one of them
+ * may use it per session. The winner claims at its FIRST INGRESS and initialises the pool for
+ * itself; the loser must not call any rx_* function at all.
+ */
+#define MSV3_POOL_OWNER_NONE    0u
+#define MSV3_POOL_OWNER_SERIAL  1u
+#define MSV3_POOL_OWNER_BLE     2u
+
+bool    hci_mem_pool_try_claim(uint8_t owner);
+uint8_t hci_mem_pool_owner(void);
+
+/* There is deliberately NO release. Handing the pool to the other transport mid-boot would give it
+ * the previous owner's stale reservation, which is precisely the defect this fixes; a safe
+ * transfer would have to stop the loser's decoding, prove no queued DFU element still holds a pool
+ * pointer, and reset the pool, in that order. Every failure path here ends in a system reset
+ * (measured RESETREAS 0x04 SREQ on probe 8), and that reset clears ownership because it lives in
+ * .bss. Keeping ownership until then is the safe choice, not an oversight. */
+
