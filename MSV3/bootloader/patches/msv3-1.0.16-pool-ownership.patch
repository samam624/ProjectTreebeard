+/* MSV3_POOL_OWNER (1.0.16): THE WIRED DFU ROOT CAUSE, AND WHY THE OBVIOUS FIX IS WRONG.
+ *
+ * There is ONE hci_mem_pool in the image and BOTH DFU transports use it -- dfu_transport_ble.c's
+ * app_data_process() calls rx_produce / rx_data_size_set / rx_extract / rx_consume on the same
+ * queue as the serial transport. Stock 0.11.0 only ever brought ONE of them up
+ * (`if (_ota_dfu) ble_stack_init(); else usb_init();`) so a single shared pool was safe by
+ * construction. MSV3 1.0.4 made both live at once, and bootloader.c now starts them in this order:
+ *
+ *     (void) dfu_transport_serial_update_start();   // opens the pool, produces slot 0,
+ *                                                   // and registers slot 0 with the SLIP layer
+ *     err_code = dfu_transport_ble_update_start();  // calls hci_mem_pool_open() AGAIN
+ *
+ * That second open zeroes write_index, read_index and every count while SLIP is still holding
+ * slot 0, so the pool's read_index runs permanently one ahead of the buffer SLIP is filling and
+ * every extract after the first returns a buffer that was produced but never written -- all zeros,
+ * whose first byte reads as INVALID_PACKET. Measured on probe 8 with bootloader 1.0.14: all nine
+ * trace values matched that replay exactly. It also explains why START always worked and nothing
+ * after it did -- rx_data_size_set() wrote slot 15 instead of slot 0, so START was extracted with
+ * a nonsense length too, but its payload POINTER was correct and dfu_start_pkt_handle() reads the
+ * image sizes out of the packet struct rather than from that length.
+ *
+ * 1.0.15 tried to fix this by opening the pool ONCE, and that release is WITHHELD because it would
+ * have broken BLE recovery. The second open is not purely destructive: it is also what DISCARDS
+ * the serial transport's outstanding reservation and hands BLE a clean pool, which is exactly why
+ * BLE OTA has worked all along. Suppress it and BLE inherits serial's produced-but-unfilled
+ * slot 0 -- BLE's first packet then produces slot 1, sets slot 1's length and extracts slot 0, the
+ * identical failure with the transports reversed, on the only channel that can recover a probe
+ * whose SWD pads are under conformal coating.
+ *
+ * The invariant is not "initialise once". It is EXACTLY ONE TRANSPORT MAY OWN THIS POOL FOR A
+ * SESSION, AND IT INITIALISES THE POOL FOR ITSELF AT ITS FIRST INGRESS. BLE claims at its first
+ * DFU data write and finds the pool already clean from boot, so it behaves byte-for-byte as it
+ * does today. Serial claims before the first CDC byte is drained and re-initialises the pool for
+ * itself. The loser never reaches rx_produce, rx_data_size_set, rx_extract or rx_consume at all --
+ * which is strictly more than dfu_transport_claim() does, since that only gates the DFU callback
+ * and leaves the pool calls reachable. Ownership lives in .bss and is cleared by the system reset
+ * that ends every session. */
+#define MSV3_POOL_OWNER_NONE    0u
+#define MSV3_POOL_OWNER_SERIAL  1u
+#define MSV3_POOL_OWNER_BLE     2u
+
+static uint8_t           m_pool_owner;
 static rx_buffer_elem_t  m_rx_buffer_elem_queue[HCI_RX_BUF_QUEUE_SIZE] __ALIGN(4); /**< RX buffer element instances. */
 static rx_buffer_queue_t m_rx_buffer_queue;                         /**< RX buffer queue element instance. */
 
@@ -76,6 +119,27 @@
  * DFU layer classifies is not the buffer that was validated. Proving that needs the pool's own
  * bookkeeping at the moment of extraction, and its indices are file-static. These two functions
  * READ and never write; nothing about the pool's behaviour changes. */
+bool hci_mem_pool_try_claim(uint8_t owner)
+{
+    if (m_pool_owner == owner)
+    {
+        return true;        /* already ours */
+    }
+    if (m_pool_owner != MSV3_POOL_OWNER_NONE)
+    {
+        return false;       /* the other transport got here first and keeps it until reset */
+    }
+    m_pool_owner = owner;
+    return true;
+}
+
+
+uint8_t hci_mem_pool_owner(void)
+{
+    return m_pool_owner;
+}
+
