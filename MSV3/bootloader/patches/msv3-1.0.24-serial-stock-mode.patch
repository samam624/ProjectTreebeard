diff --git a/src/flash_nrf5x.c b/src/flash_nrf5x.c
--- a/src/flash_nrf5x.c
+++ b/src/flash_nrf5x.c
@@ -28,11 +28,33 @@
 #include "boards.h"
 #include "dfu_types.h"
 
+#include "nrf_wdt.h"   /* MSV3 1.0.22: feed the watchdog across a multi-second erase */
+#include "boards.h"    /* MSV3 1.0.24: msv3_serial_lease_renew() */
+
 #define FLASH_CACHE_INVALID_ADDR  0xffffffff
 
 static uint32_t _fl_addr = FLASH_CACHE_INVALID_ADDR;
 static uint8_t _fl_buf[CODE_PAGE_SIZE] __attribute__((aligned(4)));
 
+/* MSV3_ERASE_WDT_FEED (1.0.22)
+ *
+ * This loop blocks the CPU completely for the whole erase: an nRF52840 page erase is up to ~85 ms
+ * and a 132 KB application bank is 33 pages, so roughly 2.8 SECONDS with no main loop, no USB
+ * servicing and -- as written -- no watchdog reload.
+ *
+ * bootloader.c reloads the watchdog once per main-loop pass and notes that the WDT "cannot be
+ * disabled once started. It even last through NVIC soft reset", so a watchdog the APPLICATION
+ * started is still running here, with a timeout chosen for an application that never blocks for
+ * seconds. Nothing feeds it across this loop.
+ *
+ * Measured on probe 8, 2026-09-21 with bootloader 1.0.21: once the wired session correctly took
+ * the SYNCHRONOUS flash path, START erased the application page and the device then vanished
+ * during the host's very next write -- the init packet -- with the transfer never resuming.
+ *
+ * Feeding all eight reload registers here costs a handful of instructions per page and is correct
+ * regardless of which reset is actually firing: a multi-second blocking erase must not be the one
+ * place in the image that starves the watchdog. If the WDT is not running, nrf_wdt_started() is
+ * false and this does nothing at all. */
 void flash_nrf5x_erase (uint32_t dst, uint32_t len)
 {
     uint32_t page_addr = dst & ~(CODE_PAGE_SIZE - 1);
@@ -41,7 +63,22 @@
     {
         uint32_t const addr = page_addr + i * CODE_PAGE_SIZE;
         PRINTF("Erase 0x%08lX\r\n", addr);
+
+        if ( nrf_wdt_started(NRF_WDT) )
+        {
+            for ( uint8_t ch = 0; ch < 8; ch++ ) nrf_wdt_reload_request_set(NRF_WDT, ch);
+        }
+
+        /* MSV3 1.0.24: the erase is the device working, not the host falling silent. Without this
+         * the serial lease counts the whole blocking erase as idleness. */
+        msv3_serial_lease_renew();
+
         nrfx_nvmc_page_erase(addr);
+    }
+
+    if ( nrf_wdt_started(NRF_WDT) )
+    {
+        for ( uint8_t ch = 0; ch < 8; ch++ ) nrf_wdt_reload_request_set(NRF_WDT, ch);
     }
 }
 
