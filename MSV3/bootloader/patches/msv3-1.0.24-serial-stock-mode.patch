+
+  while ( tud_cdc_available() && msv3_serial_rx_claim() && msv3_serial_mode_active()
+          && !rx_buffer_overflowed() && msv3_serial_rx_may_drain()
+          && (m_current_state != SLIP_TRANSMITTING) )
   {
     int8_t ch = tud_cdc_read_char();
     handle_rx_byte((uint8_t) ch);
+    /* Any real serial traffic renews the lease that guarantees a way back to BLE. */
+    msv3_serial_lease_renew();
   }
 }
 
