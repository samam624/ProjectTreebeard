diff --git a/src/main.c b/src/main.c
--- a/src/main.c
+++ b/src/main.c
@@ -143,6 +143,160 @@
 
 static void check_dfu_mode(void);
 static uint32_t ble_stack_init(void);
+static void disable_softdevice(void);
+#include "dfu_transport.h"   /* MSV3 1.0.21: dfu_transport_ble_close() for the wired-mode transition */
+#include "bootloader_types.h"   /* MSV3 1.0.23: reset tagging */
+
+/* MSV3_SERIAL_STOCK_MODE (1.0.21)
+ *
+ * WHY A WIRED SESSION HAS TO CHANGE THE BOARD'S MODE, AND WHY EVERY EARLIER FIX WAS THE WRONG SHAPE.
+ *
+ * Stock 0.11.0 brings up exactly one transport:
+ *
+ *     if (_ota_dfu) { mbr_init_sd(); ble_stack_init(); }   // SoftDevice ENABLED
+ *     else          { usb_init(serial_only_dfu); }          // wired: SoftDevice NEVER enabled
+ *
+ * so a stock WIRED session runs with no SoftDevice at all. is_ota() is false, dfu_single_bank.c
+ * takes the synchronous flash_nrf5x_* path, and dfu_start_pkt_handle()'s application-bank erase
+ * COMPLETES BEFORE IT RETURNS. By the time adafruit-nrfutil's fixed get_erase_wait_time() sleep
+ * expires the state machine is already DFU_STATE_RDY and the init packet is accepted. There is no
+ * race, which is why no upstream user reports one.
+ *
+ * MSV3 1.0.4 attached USB INSIDE the _ota_dfu branch so a probe whose SWD pads are under
+ * conformal coating keeps a wired way back in. That single change made wired DFU asynchronous, and
+ * it is the common origin of both confirmed defects: the shared hci_mem_pool being re-opened by
+ * the second transport, and the init packet arriving before an async erase had finished --
+ * whereupon dfu_init_pkt_complete() returns NRF_ERROR_INVALID_STATE and the serial path's
+ * APP_ERROR_CHECK reboots the board. That reboot is the COM port vanishing mid-transfer.
+ *
+ * Measured on probe 8: multiplying only the HOST's flash-timing constants by six -- which does
+ * nothing but lengthen that sleep -- let the init packet through and put real firmware bytes in
+ * flash for the first time (application page CRC moved from the erased 0x0FE1 to 0x4573).
+ *
+ * So instead of teaching the serial transport to survive an asynchrony stock does not have, a
+ * serial session RESTORES THE STOCK WIRED SHAPE: close BLE, disable the SoftDevice, clear
+ * _ota_dfu. Ordering is not optional. 1.0.9 already proved that forcing the synchronous flash path
+ * while the SoftDevice is still enabled faults immediately, so _ota_dfu must not be cleared until
+ * sd_softdevice_disable() has positively succeeded.
+ *
+ * THE LEASE IS THE SAFETY PROPERTY, NOT AN EXTRA. Once the SoftDevice is gone there is no BLE
+ * until the next reset, and on this hardware BLE is the only recovery channel -- there is no SWD.
+ * It is NOT true that every serial failure resets: a stray CDC write, a cable pulled mid-frame, a
+ * host that dies after START has already erased the application, or any error path that does not
+ * go through APP_ERROR_CHECK would otherwise leave the board awake, wired-only, with no route
+ * back. So entering this mode arms a lease, and losing VBUS or going quiet for
+ * MSV3_SERIAL_LEASE_MS forces a system reset, which restores the normal BLE-first bring-up
+ * through the known boot path. */
+#define MSV3_SERIAL_MODE_IDLE       0u
+#define MSV3_SERIAL_MODE_REQUESTED  1u
+#define MSV3_SERIAL_MODE_ACTIVE     2u
+#define MSV3_SERIAL_MODE_FAILED     3u
+
+/* MSV3 1.0.24: the lease is counted in MAIN LOOP PASSES, not RTC1 ticks.
+ *
+ * 1.0.23 timed it from NRF_RTC1->COUNTER and that was wrong on this board specifically. The MSV3
+ * E73 module has NO 32.768 kHz crystal -- every build in this project selects the internal LFRC
+ * before the SoftDevice starts, which is what the LFCLK compile guards exist to enforce -- so
+ * RTC1's clock source is disturbed by sd_softdevice_disable(). If the counter restarts, the
+ * unsigned (now - mark) wraps to an enormous value and the lease fires IMMEDIATELY.
+ *
+ * Measured on probe 8, 2026-09-21: the wired transfer died 3.4 s in with reset_tag 4, the idle
+ * lease, against a nominal 10 s timeout. The safety mechanism was killing the transfer it was
+ * added to protect.
+ *
+ * A pass counter cannot be fooled by a clock that stops or restarts. It is a coarse measure of
+ * time -- the loop rate varies with USB and flash activity -- so it is sized generously. That
+ * errs in the safe direction: the lease exists to guarantee the board EVENTUALLY returns to BLE,
+ * and the cable-pull case, which is the dangerous one, is caught immediately by the VBUS check
+ * below rather than by this counter. */
+#define MSV3_SERIAL_LEASE_PASSES    3000000u
+
+static volatile uint8_t  m_serial_mode;
+static volatile uint32_t m_serial_lease_idle;
+
+void msv3_serial_mode_request(void)
+{
+  if (m_serial_mode == MSV3_SERIAL_MODE_IDLE) m_serial_mode = MSV3_SERIAL_MODE_REQUESTED;
+}
+
+bool msv3_serial_mode_requested(void)
+{
+  return m_serial_mode == MSV3_SERIAL_MODE_REQUESTED;
+}
+
+bool msv3_serial_mode_active(void)
+{
+  return m_serial_mode == MSV3_SERIAL_MODE_ACTIVE;
+}
+
+void msv3_serial_lease_renew(void)
+{
+  m_serial_lease_idle = 0;
+}
+
+/* Called from the MAIN LOOP only. Never from tud_cdc_rx_cb, a BLE event, or the scheduler: this
+ * tears down the SoftDevice, and doing that from inside one of its own callbacks is how a
+ * bootloader stops being recoverable. */
+void msv3_serial_mode_begin(void)
+{
+  uint8_t sd_enabled = 0;
+
+  if (m_serial_mode != MSV3_SERIAL_MODE_REQUESTED) return;
+
+  /* 1. Stop BLE presenting any further work. dfu_transport_ble_close() stops advertising and
+   *    releases the transport; 1.0.5 already relies on it doing exactly this. */
+  (void) dfu_transport_ble_close();
+
+  /* 2. Drain anything the SoftDevice still has queued, so nothing calls an sd_* API after the
+   *    disable below. */
+  app_sched_execute();
+
+  /* 3. Disable, and CHECK. Until this succeeds the board must keep behaving as it does today. */
+  sd_softdevice_is_enabled(&sd_enabled);
+  if (sd_enabled == 1)
+  {
+    if (NRF_SUCCESS != sd_softdevice_disable())
+    {
+      /* Busy. Stay requested and try again on the next pass rather than half-transitioning. */
+      return;
+    }
+  }
+
+  sd_softdevice_is_enabled(&sd_enabled);
+  if (sd_enabled != 0)
+  {
+    m_serial_mode = MSV3_SERIAL_MODE_FAILED;
+    return;
+  }
+
+  /* 4. Only now is the synchronous flash path legal. */
+  _sd_inited = false;
+  _ota_dfu   = false;
+
+  msv3_serial_lease_renew();
+  m_serial_mode = MSV3_SERIAL_MODE_ACTIVE;
+}
+
+/* Main loop. Enforces the lease described above. */
+void msv3_serial_lease_check(void)
+{
+  if (m_serial_mode != MSV3_SERIAL_MODE_ACTIVE) return;
+
+#ifdef NRF_USBD
+  /* Cable gone. The host cannot finish, and the application may already be erased. */
+  if (!(NRF_POWER->USBREGSTATUS & POWER_USBREGSTATUS_VBUSDETECT_Msk))
+  {
+    MSV3_DFU_TRACE->reset_tag = MSV3_RESET_TAG_LEASE_VBUS;
+    NVIC_SystemReset();
+  }
+#endif
+
+  if (++m_serial_lease_idle > MSV3_SERIAL_LEASE_PASSES)
+  {
+    MSV3_DFU_TRACE->reset_tag = MSV3_RESET_TAG_LEASE_IDLE;
+    NVIC_SystemReset();
+  }
+}
 
