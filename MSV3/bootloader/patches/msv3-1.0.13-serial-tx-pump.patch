+  tud_cdc_write_flush();
+  transmit_buffer();
+
+  if ( (m_tx_buffer_index != before) && (MSV3_DFU_TRACE->magic == MSV3_DFU_TRACE_MAGIC) &&
+       (MSV3_DFU_TRACE->tx_resume_count != 0xFFFFU) )
+  {
+    MSV3_DFU_TRACE->tx_resume_count++;
+  }
