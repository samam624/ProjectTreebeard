+/* MSV3 1.0.6: fill the retained trace from state only this file can see.
+ *
+ * m_dfu_state, m_data_received, m_image_size and mp_storage_handle_active are all static here, and
+ * the question that has to be answered is precisely whether m_data_received == m_image_size at
+ * STOP_DATA -- because dfu_image_validate()'s first branch returns NRF_ERROR_INVALID_STATE when
+ * they differ, which is indistinguishable at the call site from the default-branch
+ * NRF_ERROR_INVALID_STATE for a wrong m_dfu_state.
+ *
+ * The CRC is computed over the image AS STAGED IN FLASH, after reception, so it can be compared
+ * against a CRC of the exact bytes the host sent. Equal counts with an unequal CRC would mean the
+ * bytes arrived and landed wrong; unequal counts mean they never all arrived. Deliberately not
+ * per-packet: this must not perturb the receive path it is measuring.
+ */
+void msv3_dfu_trace_capture(void)
+{
+    volatile msv3_dfu_trace_t * t = MSV3_DFU_TRACE;
+
+    t->state_before  = (uint8_t)m_dfu_state;
+    t->data_received = m_data_received;
+    t->image_size    = m_image_size;
+
+    if ((mp_storage_handle_active != NULL) && (m_image_size > 0))
+    {
+        t->staged_crc16 = crc16_compute((uint8_t *)mp_storage_handle_active->block_id,
+                                        m_image_size, NULL);
+    }
+}
+
+
+void msv3_dfu_trace_state_after(void)
+{
+    MSV3_DFU_TRACE->state_after = (uint8_t)m_dfu_state;
+}
+
