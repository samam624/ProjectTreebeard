+/* MSV3_DFU_TRACE_MAGIC
+ *
+ * 1.0.6 decision record for a DFU session, retained across the reset that ends it.
+ *
+ * Why this exists: stock 0.11.0's serial STOP_DATA handler is
+ *     (void)dfu_image_validate();
+ *     (void)dfu_image_activate();
+ * and the host client's send_validate_firmware()/send_activate_firmware() send nothing at all, so
+ * when a wired update fails NEITHER SIDE CAN SAY WHY. Measured 2026-09-20 on probe 8: six wired
+ * transfers delivered every byte, reported success, and left no valid application, while the same
+ * signed packages over BLE worked every time. Host-side timing, init-packet padding, per-frame
+ * pacing, chunk geometry, a port-open hold before STOP_DATA and (in 1.0.5) quiescing the radio
+ * before activate were each tried and each changed nothing. There is no host experiment left; the
+ * device has to report.
+ *
+ * Lives at a fixed address in MSV3_DFU_TRACE, a 64-byte region the linker EXCLUDES from RAM, so
+ * nothing the bootloader links can reach it. It is NOT cleared at boot -- clearing at boot would
+ * destroy the evidence on the very reset that makes DFU reachable again. It is armed only when a
+ * new START packet is accepted.
+ *
+ * stage is the load-bearing field. ENTER is written before each call and RETURN after it, so a
+ * record stuck at an ENTER value means the device died INSIDE that call -- which a return code
+ * alone can never distinguish from "returned an error".
+ */
+#define MSV3_DFU_TRACE_MAGIC            0x4D535654UL   /* "MSVT" */
+#define MSV3_DFU_TRACE_ADDR             0x2003FFB8UL
+
+#define MSV3_DFU_STAGE_ARMED            0x01u
+#define MSV3_DFU_STAGE_VALIDATE_ENTER   0x02u
+#define MSV3_DFU_STAGE_VALIDATE_RETURN  0x03u
+#define MSV3_DFU_STAGE_ACTIVATE_ENTER   0x04u
+#define MSV3_DFU_STAGE_ACTIVATE_RETURN  0x05u
+
+/* transport, so a BLE control run and a wired run are never confused for one another. */
+#define MSV3_DFU_TRANSPORT_NONE         0x00u
+#define MSV3_DFU_TRANSPORT_SERIAL       0x01u
+#define MSV3_DFU_TRANSPORT_BLE          0x02u
+
+typedef struct
+{
+    uint32_t magic;             /**< MSV3_DFU_TRACE_MAGIC once armed. */
+    uint8_t  format;            /**< Layout version. 1 = this. */
+    uint8_t  transport;         /**< MSV3_DFU_TRANSPORT_*. */
+    uint8_t  stage;             /**< MSV3_DFU_STAGE_*, the furthest point reached. */
+    uint8_t  state_before;      /**< m_dfu_state immediately before dfu_image_validate(). */
+    uint8_t  state_after;       /**< m_dfu_state immediately after it returned. */
+    uint8_t  pad0;
+    uint16_t staged_crc16;      /**< CRC16 over the staged image, computed AFTER reception. */
+    uint32_t data_received;     /**< m_data_received at STOP_DATA. */
+    uint32_t image_size;        /**< m_image_size at STOP_DATA. These two differing IS the answer. */
+    uint32_t validate_rc;       /**< Raw dfu_image_validate() return. */
+    uint32_t activate_rc;       /**< Raw dfu_image_activate() return, if it returned at all. */
+    uint32_t frames_queued;     /**< DATA frames accepted into the queue by the transport. */
+    uint32_t frames_dropped;    /**< DATA frames the transport ACKed and then DISCARDED on queue-full. */
+    uint32_t check;             /**< ~magic, written LAST. A torn record fails this. */
+} msv3_dfu_trace_t;
+
+_Static_assert(sizeof(msv3_dfu_trace_t) <= 0x40,
+               "the DFU trace must fit the 64-byte MSV3_DFU_TRACE region the linker reserves");
+_Static_assert(sizeof(msv3_dfu_trace_t) % 4 == 0, "keep the trace word-aligned");
+
+#define MSV3_DFU_TRACE ((volatile msv3_dfu_trace_t *)MSV3_DFU_TRACE_ADDR)
+
+/**@brief Arm a fresh record. Called when a START packet is accepted, never at boot. */
+static inline void msv3_dfu_trace_arm(uint8_t transport)
+{
+    volatile msv3_dfu_trace_t * t = MSV3_DFU_TRACE;
+    t->magic          = MSV3_DFU_TRACE_MAGIC;
+    t->format         = 1;
+    t->transport      = transport;
+    t->stage          = MSV3_DFU_STAGE_ARMED;
+    t->state_before   = 0xFF;
+    t->state_after    = 0xFF;
+    t->pad0           = 0;
+    t->staged_crc16   = 0;
+    t->data_received  = 0;
+    t->image_size     = 0;
+    t->validate_rc    = 0xFFFFFFFFUL;
+    t->activate_rc    = 0xFFFFFFFFUL;
+    t->frames_queued  = 0;
+    t->frames_dropped = 0;
+    t->check          = ~MSV3_DFU_TRACE_MAGIC;
+}
+
+#endif // BOOTLOADER_TYPES_H__
 
 /**@} */
