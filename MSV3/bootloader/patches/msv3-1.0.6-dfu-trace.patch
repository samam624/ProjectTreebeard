+/**@brief MSV3 1.0.6: publish the retained DFU trace as scan-response manufacturer data.
+ *
+ * The SCAN RESPONSE, deliberately, not the advertisement: the advertisement is already 29 of its
+ * 31 bytes (flags + "AdaDFU" + the 128-bit DFU UUID) and every one of those is load-bearing --
+ * scripts/ble_dfu_recover.py finds a board by that name and msv3_fleet_scan.py by that service.
+ * Nothing here may disturb either. The scan response is otherwise empty.
+ *
+ * Passive by construction: a scan reads it without connecting, without touching the USB CDC
+ * endpoint, and without injecting a single byte into the SLIP stream that is under investigation.
+ * It also does not clear the record -- a missed scan must not destroy the evidence.
+ */
+static void scan_response_init(ble_data_t* scan_data)
+{
+  volatile msv3_dfu_trace_t * t = MSV3_DFU_TRACE;
+
+  if ( (t->magic != MSV3_DFU_TRACE_MAGIC) || (t->check != ~MSV3_DFU_TRACE_MAGIC) ) return;
+
+  /* Company ID first, per the manufacturer-specific data format. 0xFFFF is the reserved
+   * "not assigned" identifier, which is what this project already advertises from the
+   * application, so a scanner sees one consistent vendor across both images. */
+  /* 27 payload bytes -> a 29-byte AD structure, inside the 31-byte scan response with room to
+   * spare. frames_dropped is saturated into 16 bits because its only interesting values are 0 and
+   * "not 0"; a full 32-bit counter would not fit alongside both return codes, and the return codes
+   * are what actually name the failing branch. */
+  uint8_t payload[27];
+  uint8_t i = 0;
+
+  uint16_t dropped = (t->frames_dropped > 0xFFFFUL) ? 0xFFFFU : (uint16_t)t->frames_dropped;
+
+  payload[i++] = 0xFF;
+  payload[i++] = 0xFF;
+  payload[i++] = t->format;
+  payload[i++] = t->transport;
+  payload[i++] = t->stage;
+  payload[i++] = t->state_before;
+  payload[i++] = t->state_after;
+  memcpy(&payload[i], (const void *)&t->staged_crc16, 2);   i += 2;
+  memcpy(&payload[i], (const void *)&t->data_received, 4);  i += 4;
+  memcpy(&payload[i], (const void *)&t->image_size, 4);     i += 4;
+  memcpy(&payload[i], (const void *)&t->validate_rc, 4);    i += 4;
+  memcpy(&payload[i], (const void *)&t->activate_rc, 4);    i += 4;
+  memcpy(&payload[i], &dropped, 2);                         i += 2;
+
+  advertising_add(scan_data, BLE_GAP_AD_TYPE_MANUFACTURER_SPECIFIC_DATA, payload, i);
+}
+
