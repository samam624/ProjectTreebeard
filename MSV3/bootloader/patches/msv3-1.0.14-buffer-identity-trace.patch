--- a/lib/sdk/components/libraries/hci/hci_mem_pool.c
+++ b/lib/sdk/components/libraries/hci/hci_mem_pool.c
@@ -69,6 +69,43 @@
 static rx_buffer_queue_t m_rx_buffer_queue;                         /**< RX buffer queue element instance. */
 
 
+/* MSV3_POOL_INSPECT (1.0.14): read-only windows into the pool, for the retained DFU trace.
+ *
+ * The wired transfer's 15 rejected frames all passed CRC and the HCI sequence check and were all
+ * acknowledged, and the host has been proven to build every frame correctly -- so the buffer the
+ * DFU layer classifies is not the buffer that was validated. Proving that needs the pool's own
+ * bookkeeping at the moment of extraction, and its indices are file-static. These two functions
+ * READ and never write; nothing about the pool's behaviour changes. */
+uint8_t hci_mem_pool_rx_slot_of(const uint8_t * p_buffer)
+{
+    uint32_t index;
+
+    if (m_rx_buffer_queue.p_buffer == NULL) return 0xFFu;
+
+    for (index = 0; index < HCI_RX_BUF_QUEUE_SIZE; index++)
+    {
+        if ((const uint8_t *)m_rx_buffer_queue.p_buffer[index].rx_buffer == p_buffer)
+        {
+            return (uint8_t)index;
+        }
+    }
+    return 0xFFu;   /* not one of ours: the ack buffer, a stale pointer, or an adjusted one */
+}
+
+void hci_mem_pool_rx_counters(uint8_t * p_read_index,
+                              uint8_t * p_write_index,
+                              uint8_t * p_read_available,
+                              uint8_t * p_free_available,
+                              uint8_t * p_free_window)
+{
+    *p_read_index     = (uint8_t)m_rx_buffer_queue.read_index;
+    *p_write_index    = (uint8_t)m_rx_buffer_queue.write_index;
+    *p_read_available = (uint8_t)m_rx_buffer_queue.read_available_count;
+    *p_free_available = (uint8_t)m_rx_buffer_queue.free_available_count;
+    *p_free_window    = (uint8_t)m_rx_buffer_queue.free_window_count;
+}
+
+
 uint32_t hci_mem_pool_open(void)
 {
     m_is_tx_allocated                      = false;
