 #  error Incorrect layout: r and s must be contiguous!
 # endif
 	
-	return uECC_verify(pk, digest, sizeof(digest), sig, curve) == 1 ? NRF_SUCCESS : NRF_ERROR_INVALID_DATA;
+	if (uECC_verify(pk, digest, sizeof(digest), sig, curve) != 1)
+	{
+		return NRF_ERROR_INVALID_DATA;
+	}
+
+	/* ---- MSV3 1.0.2 anti-rollback. Everything above has authenticated the init packet. ----
+	 *
+	 * Applies to application images only. A SoftDevice or bootloader package carries its own
+	 * version semantics and is refused over BLE by host policy long before it reaches here.
+	 *
+	 * EQUALITY MUST PASS. Reinstalling the current known-good version is the recovery path used
+	 * after a refused rollback erases the application, so `<` and not `<=` is load-bearing.
+	 *
+	 * NRF_ERROR_INVALID_PARAM is returned rather than NRF_ERROR_FORBIDDEN or
+	 * NRF_ERROR_INVALID_DATA because both of those are already reachable here -- device type and
+	 * unlock code return FORBIDDEN, and every signature/format failure returns INVALID_DATA. The
+	 * transport maps INVALID_PARAM to BLE_DFU_RESP_VAL_NOT_SUPPORTED, a value nothing else can
+	 * produce at the Init Packet stage (its only other source is dfu_start_pkt_handle, i.e. Start
+	 * DFU). So "NOT_SUPPORTED at Init Packet" means rollback-refused and nothing else, which is
+	 * what makes the acceptance test conclusive instead of inferential.
+	 */
+	if (image_type & DFU_UPDATE_APP)
+	{
+		if (p_init_packet->app_version < msv3_version_floor_get())
+		{
+			return NRF_ERROR_INVALID_PARAM;
+		}
+		m_msv3_pending_app_version = p_init_packet->app_version;
+	}
+
+	return NRF_SUCCESS;
 #endif
