 } dfu_init_packet_t;
 
+/**@brief MSV3 1.0.2: the application version carried by the most recently ACCEPTED init packet.
+ *
+ * Set by dfu_init_prevalidate() only after the P-256 signature over the init packet has verified
+ * and the anti-rollback comparison has passed, and cleared at the top of every prevalidate call.
+ * Returns 0 when no authenticated application version is pending, which bootloader.c treats as
+ * "do not touch the stored floor".
+ *
+ * The value is deliberately NOT committed here. It reaches flash only if the transfer goes on to
+ * pass dfu_init_postvalidate() (image length + SHA-256 + signature) and reaches
+ * DFU_UPDATE_APP_COMPLETE, so an interrupted, corrupted or abandoned higher-version transfer can
+ * never raise the floor and strand the probe above its own rescue image.
+ */
+uint32_t msv3_pending_app_version_get(void);
+
 /**@brief Structure holding basic device information settings.
  */
 typedef struct
