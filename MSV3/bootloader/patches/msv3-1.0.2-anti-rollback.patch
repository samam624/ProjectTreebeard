         case NRF_ERROR_INVALID_DATA:
             if (current_dfu_proc == BLE_DFU_VALIDATE_PROCEDURE)
             {
diff --git a/src/dfu_init.c b/src/dfu_init.c
index 612fed9..eaf03b7 100644
--- a/src/dfu_init.c
+++ b/src/dfu_init.c
@@ -72,6 +72,64 @@
 #include <string.h>
 #include <dfu_types.h>
 #include "nrf_error.h"
+#include "bootloader_types.h"
+#include "bootloader_settings.h"
+
+/* ==== MSV3 1.0.2 anti-rollback =============================================================
+ *
+ * Measured on probe 99, 2026-09-05: stock 0.11.0 installs an OLDER validly signed image without
+ * complaint. The template below this comment block says why in Nordic's own words -- "This
+ * template allows for any application to be installed." That is not merely untidy: rolling a
+ * probe back past guard 1 restores the defect where a sensor fault closes the radio, so a
+ * rollback can re-introduce a fixed unrecoverability bug on a board whose SWD pads are under
+ * conformal coating.
+ *
+ * ORDERING IS THE WHOLE DESIGN. The comparison happens AFTER the P-256 signature over the init
+ * packet verifies, so an unauthenticated peer cannot use the response to probe the stored floor,
+ * and a rollback attempt is refused on its merits rather than by accident of some earlier check.
+ * It is also the last thing prevalidate does, so device type, unlock code and SoftDevice
+ * requirement still fail first and keep their existing error codes.
+ *
+ * NOTE WHAT THIS DOES NOT FIX. The application is still erased at Start DFU, before any of this
+ * runs (dfu_start_pkt_handle -> dfu_prepare_func_app_erase). A refused rollback therefore still
+ * costs the running application. That is unchanged from 1.0.1 and is a deliberate scope decision:
+ * deferring the erase would require Start to complete before erasing, Init completion to wait on
+ * an asynchronous erase, and the flash-completion handler to distinguish which command it is
+ * completing -- the same state-machine restructuring implicated in the completion-gate defect
+ * this file's sibling comment describes. Recovery from that erase is proven; a bricked bootloader
+ * is not recoverable at all.
+ */
+static uint32_t m_msv3_pending_app_version;
+
+uint32_t msv3_pending_app_version_get(void)
+{
+	return m_msv3_pending_app_version;
+}
+
+/**@brief Reads the stored anti-rollback floor, or 0 if none is validly recorded.
+ *
+ * FAILS OPEN BY DESIGN. Absent magic (erased page, or a page written by 1.0.0/1.0.1) and a torn
+ * write (complement mismatch) both return 0, which accepts any version. The alternative -- fail
+ * closed on an unreadable floor -- would let a single interrupted settings write turn a probe
+ * into one that refuses every package including its own rescue image, on hardware where SWD is
+ * gone. Between "an interrupted write costs the rollback guarantee until the next successful
+ * install" and "an interrupted write bricks the probe", only the first is acceptable here.
+ */
+static uint32_t msv3_version_floor_get(void)
+{
+	const bootloader_settings_t * p_settings;
+	bootloader_util_settings_get(&p_settings);
+
+	if (p_settings->msv3_version_magic != MSV3_VERSION_FLOOR_MAGIC)
+	{
+		return 0;
+	}
+	if ((p_settings->msv3_version_floor ^ p_settings->msv3_version_floor_cpl) != 0xFFFFFFFFUL)
+	{
+		return 0;
+	}
+	return p_settings->msv3_version_floor;
+}
 
