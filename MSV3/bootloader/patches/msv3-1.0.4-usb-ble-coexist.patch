+uint32_t bootloader_dfu_start_dual(void)
+{
+  uint32_t err_code;
+
+  m_cancel_timeout_on_usb    = false;
+  m_usb_was_mounted          = false;
+  m_startup_dfu_has_activity = false;
+  m_dual_transport           = true;
+
+  // Clear swap if banked update is used. Called once for the whole session: dfu_init() creates and
+  // starts the inactivity timer, so calling it per transport would re-create a live app_timer.
+  err_code = dfu_init();
+  VERIFY_SUCCESS(err_code);
+
+  // Serial first, so the SLIP decoder is armed before a wired host's first frame can arrive.
+  // Registration order does not decide who wins -- dfu_transport_claim() does, at the first packet.
+  (void) dfu_transport_serial_update_start();
+  err_code = dfu_transport_ble_update_start();
+
+  wait_for_events();
+
+  return err_code;
+}
