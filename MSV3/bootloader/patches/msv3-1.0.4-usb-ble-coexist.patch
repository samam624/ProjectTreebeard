+bool dfu_transport_claim(dfu_callback_t callback_handler)
+{
+    if (m_dfu_owner_cb == callback_handler)
+    {
+        // Already ours. The common case once a transfer is under way.
+        return true;
+    }
+
+    if ((m_dfu_owner_cb != NULL) && (m_dfu_state != DFU_STATE_IDLE))
+    {
+        // Somebody else is mid-update. Refusing here is the whole point: single-bank DFU has
+        // already erased the application by the time data packets flow, so a second transport
+        // writing into the same bank would leave neither image recoverable.
+        return false;
+    }
+
+    m_dfu_owner_cb = callback_handler;
+    m_data_pkt_cb  = callback_handler;
+    return true;
+}
