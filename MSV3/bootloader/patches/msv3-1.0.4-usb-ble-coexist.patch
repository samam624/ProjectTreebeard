+/*
+ * MSV3 1.0.4: keep a wired way back into a probe whose SWD pads are under conformal coating.
+ *
+ * Stock 0.11.0 brings up one transport -- `if (_ota_dfu) ble_stack_init(); else usb_init();` -- and
+ * DEFAULT_TO_OTA_DFU forces _ota_dfu whenever `!valid_app || dfu_start`. So the USB branch is
+ * unreachable in exactly the case that matters, and a coated MSV3 with a dead application has BLE
+ * as its only route. That is a policy choice in an if/else, not a stack limitation: usb_init()
+ * already supports a running SoftDevice (it branches on sd_softdevice_is_enabled() and routes power
+ * events through sd_power_usbdetected/usbpwrrdy/usbremoved, leaving IRQ priorities 0-1 to the SD),
+ * wait_for_events() already calls tud_task() whenever tusb_inited() regardless of DFU mode, and
+ * serial DFU *is* USB CDC -- hci_slip.c's tud_cdc_rx_cb() feeds the SLIP decoder straight from
+ * tud_cdc_read_char().
+ *
+ * The one real obstacle was that dfu_register_callback() holds a single slot and single-bank DFU
+ * erases the application before Init authentication, so two transports feeding one bank would
+ * destroy the image. dfu_transport_claim() now arbitrates that: both transports are open, the first
+ * to present traffic while the state machine is idle owns the session, and the loser is refused
+ * until dfu_init() resets ownership.
+ *
+ * USB is therefore normal here -- present whenever a cable is, for as long as it is, with no timer
+ * and no window to miss -- and BLE OTA runs on top of it rather than instead of it. With no cable,
+ * VBUSDETECT is clear, USB is never initialized, and a battery/solar probe behaves byte-for-byte as
+ * it does on 1.0.3.
+ *
+ * Design, risks, and the acceptance criteria this must pass on probe 99 before any fleet probe runs
+ * it: MSV3/docs/MSV3_USB_AND_BLE_OTA_COEXISTENCE_DESIGN_2026-09-14.md
+ */
+#define MSV3_USB_BLE_COEXIST 1
+
+#if defined(NRF_USBD) && MSV3_USB_BLE_COEXIST
+/*
+ * noinline is load-bearing, not style. check_dfu_mode() is static and is inlined into main(), so a
+ * static helper called once from it leaves no symbol in the link map -- and the map is where
+ * build_msv3_release.ps1 proves the wired path actually linked. A source sentinel cannot tell
+ * "compiled in" from "#define still sitting in the file". This was measured, not assumed: the first
+ * 1.0.4 build linked with no such symbol at all because it had been inlined away.
+ */
+__attribute__((noinline, used))
+static bool msv3_usb_attach_if_vbus(void)
+{
+  /*
+   * The SoftDevice is enabled by the time this runs, so USBREGSTATUS is read through the SVC.
+   * usb_init() performs the same check again for its own purposes.
+   */
+  uint32_t usb_reg = 0;
+  uint8_t  sd_en   = false;
+
+  if (is_sd_existed()) {
+    sd_softdevice_is_enabled(&sd_en);
+  }
+
+  if (sd_en) {
+    if (sd_power_usbregstatus_get(&usb_reg) != NRF_SUCCESS) {
+      return false;
+    }
+  } else {
+    usb_reg = NRF_POWER->USBREGSTATUS;
+  }
+
+  if (!(usb_reg & POWER_USBREGSTATUS_VBUSDETECT_Msk)) {
+    return false;
+  }
+
+  /*
+   * CDC only, never UF2. Mass storage writes unsigned images by definition, which would route a
+   * host straight around signed-init verification, the device-type check and the monotonic version
+   * floor -- the three things the fleet's update safety actually rests on.
+   */
+  usb_init(true);
+  return true;
+}
+#endif
