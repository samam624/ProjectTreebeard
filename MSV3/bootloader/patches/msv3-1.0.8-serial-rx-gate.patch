@@ -150,6 +151,16 @@
     if ( tusb_inited() )
     {
       tud_task();
+
+      /* MSV3 1.0.8: reopen the gated SLIP drain.
+       *
+       * hci_slip.c stops taking bytes off the CDC endpoint while the DFU packet queue is near
+       * capacity, which NAKs the host instead of acknowledging frames that would then be
