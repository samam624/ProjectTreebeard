   payload[i++] = t->good_completed_slot;
   payload[i++] = t->good_extracted_slot;
   payload[i++] = t->fail_completed_slot;
-  payload[i++] = t->fail_completed_hdr0;
+  payload[i++] = t->init_retry;   /* MSV3 1.0.18, replacing the answered fail_completed_hdr0 */
   payload[i++] = t->fail_ordinal;
   payload[i++] = t->fail_extract_rc;
   payload[i++] = t->fail_extracted_slot;
