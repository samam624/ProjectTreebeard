{
  "name": "msv2-agent-supervisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A bounded local Claude-Codex collaboration supervisor.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "doctor": "tsx src/index.ts doctor",
    "start": "tsx src/index.ts run",
    "demo": "tsx src/index.ts run --mock --allow-write --allow-dirty --yes --task \"Add input validation without changing public behavior\"",
    "live": "tsx src/live-server.ts",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.238",
    "@openai/codex-sdk": "0.149.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
