# Cache-Control lives only in the path-specific blocks below, never on /* here:
# Netlify concatenates header values from every block that matches a given path rather
# than letting the more specific one win, so a Cache-Control set on both /* and
# /assets/* would ship as "no-store, public, max-age=..." on every asset request -
# and per RFC 7234, no-store's presence anywhere in that list means caches must still
# treat it as no-store, silently defeating the long-cache/immutable intent below.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://lyemomfpzkawqecpfufm.supabase.co; base-uri 'none'; frame-ancestors 'none'; object-src 'none'
  Permissions-Policy: camera=(self), microphone=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app shell: never cached, so a deploy's new app.vNN.js/sw.js is always fetched
# fresh rather than trapped behind a stale cached copy of the page that references it.
/
  Cache-Control: no-store

/index.html
  Cache-Control: no-store

/manifest.webmanifest
  Cache-Control: no-store

/app-icon.svg
  Cache-Control: no-store

/sw.js
  Cache-Control: no-store
